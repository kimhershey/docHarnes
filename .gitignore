# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

node_modules
dist
dist-ssr
*.local

# Editor directories and files
.vscode/*
!.vscode/extensions.json
.idea
.DS_Store
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# Rust
/target/
/crates/**/target/

# Tests
/test-results/
/playwright-report/
/coverage/

# Build artefacts
/src-tauri/gen/schemas/
/src-tauri/target/

# Local models / workspaces must never be committed
*.gguf
# …except the synthetic (random-weight, <1 MB) test fixture used by the real-engine test
!crates/doculens-core/tests/fixtures/**/*.gguf
/.doculens/
/workspace/

# PDFium binaries placed by scripts/fetch-pdfium.mjs --bundle (never committed)
src-tauri/resources/pdfium/*
!src-tauri/resources/pdfium/.gitkeep

# ko-dic dictionary built by scripts/fetch-kodic.mjs --bundle (never committed)
src-tauri/resources/ko-dic/*
!src-tauri/resources/ko-dic/.gitkeep

# llama-server packs placed by scripts/fetch-engine.mjs --bundle (never committed)
src-tauri/resources/engines/*
!src-tauri/resources/engines/.gitkeep

# Third-party license texts generated at build time by scripts/gen-notices.mjs
# (THIRD-PARTY-NOTICES.md and sbom.cdx.json are generated too, but committed and checked by CI)
src-tauri/resources/licenses/*
!src-tauri/resources/licenses/.gitkeep

# Evaluation harness: locally generated fixtures / outputs (eval/README.md)
/eval/fixtures/
/eval/out/
