{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "DocuLens",
  "version": "0.6.0",
  "identifier": "com.doculens.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "DocuLens",
        "width": 1280,
        "height": 800,
        "minWidth": 960,
        "minHeight": 600,
        "center": true,
        "dragDropEnabled": true
      }
    ],
    "security": {
      "csp": {
        "default-src": "'self'",
        "script-src": "'self'",
        "style-src": "'self' 'unsafe-inline'",
        "img-src": "'self' asset: http://asset.localhost doculens: http://doculens.localhost data: blob:",
        "font-src": "'self' data:",
        "connect-src": "'self' ipc: http://ipc.localhost",
        "worker-src": "'self' blob:"
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "createUpdaterArtifacts": false,
    "publisher": "DocuLens",
    "copyright": "DocuLens contributors",
    "category": "Productivity",
    "shortDescription": "Offline VLM document processing",
    "longDescription": "DocuLens processes business documents on your PC with a local vision-language model. Nothing leaves the machine.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": {
      "../THIRD-PARTY-NOTICES.md": "THIRD-PARTY-NOTICES.md",
      "../sbom.cdx.json": "sbom.cdx.json",
      "resources/licenses/": "licenses/",
      "resources/engines/": "engines/",
      "resources/pdfium/": "pdfium/",
      "resources/ko-dic/": "ko-dic/"
    },
    "windows": {
      "webviewInstallMode": { "type": "downloadBootstrapper", "silent": true },
      "nsis": {
        "installMode": "currentUser",
        "languages": ["Korean", "English"],
        "displayLanguageSelector": true,
        "installerIcon": "icons/icon.ico",
        "template": "nsis/installer.nsi"
      }
    }
  }
}
